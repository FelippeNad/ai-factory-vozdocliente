        "jsonBody": "={\n  \"fields\": {\n    \"review_id\": {{ JSON.stringify($('Parse + Merge').item.json.review_id) }},\n    \"customer_name\": {{ JSON.stringify($('Parse + Merge').item.json.customer_name) }},\n    \"source\": {{ JSON.stringify($('Parse + Merge').item.json.source) }},\n    \"rating\": {{ $('Parse + Merge').item.json.rating }},\n    \"review_text\": {{ JSON.stringify($('Parse + Merge').item.json.review_text) }},\n    \"sentiment\": {{ JSON.stringify($('Parse + Merge').item.json.sentiment) }},\n    \"theme\": {{ JSON.stringify($('Parse + Merge').item.json.theme) }},\n    \"processed_at\": {{ JSON.stringify($('Parse + Merge').item.json.processed_at) }}\n  }\n}",
        "options": {}
