      ],
      "webhookId": "vozdocliente-review-router"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:1234/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen/qwen3-4b-2507\",\n  \"temperature\": 0.1,\n  \"max_tokens\": 200,\n  \"response_format\": { \"type\": \"text\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Você é um classificador de avaliações de clientes da VozDoCliente (SaaS de CX para varejo e marketplaces). Leia o texto da avaliação e responda APENAS com um JSON válido, sem texto extra, no formato: {\\\"sentiment\\\": \\\"<positivo|neutro|negativo>\\\", \\\"theme\\\": \\\"<entrega|produto|atendimento|preco|app_bug>\\\"}. Definições de sentiment: positivo (elogio/satisfeito), neutro (dúvida/sugestão sem carga), negativo (reclamação/frustração). Definições de theme: entrega (prazo/frete/extravio), produto (qualidade/defeito), atendimento (SAC/troca/reembolso), preco (valor/cobrança/cupom), app_bug (erro no app/site/checkout).\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.body.review_text) }}\n    }\n  ]\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "73201e6d-1616-4928-a95f-dba0a2827202",
      "name": "OpenAI Classificar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -976,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Faz o parse do JSON que o LLM devolveu e junta com o payload original do webhook.\n// Agora trata respostas inválidas do LLM e valida sentiment/theme.\n\nconst llmRaw = $json?.choices?.[0]?.message?.content;\n\nif (!llmRaw || typeof llmRaw !== 'string') {\n  throw new Error('Resposta do LLM ausente ou em formato inválido.');\n}\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(llmRaw);\n} catch (error) {\n  throw new Error(`Resposta do LLM não é um JSON válido: ${llmRaw}`);\n}\n\nconst webhook = $('Webhook Review').first().json.body;\n\nconst sentiment = (parsed.sentiment || '').toLowerCase().trim();\nconst theme = (parsed.theme || '').toLowerCase().trim();\n\nconst allowedSentiments = ['positivo', 'neutro', 'negativo'];\nconst allowedThemes = ['entrega', 'produto', 'atendimento', 'preco', 'app_bug'];\n\nif (!allowedSentiments.includes(sentiment)) {\n  throw new Error(`Sentiment inválido: ${sentiment}`);\n}\n\nif (!allowedThemes.includes(theme)) {\n  throw new Error(`Theme inválido: ${theme}`);\n}\n\nreturn [\n  {\n    json: {\n      review_id: webhook.review_id,\n      customer_name: webhook.customer_name,\n      source: webhook.source,\n      rating: webhook.rating,\n      review_text: webhook.review_text,\n      sentiment: sentiment,\n      theme: theme,\n      processed_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "2d999cef-4451-4d0d-a906-5722b7092e00",
      "name": "Parse + Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -736,
        112
      ]
    },
