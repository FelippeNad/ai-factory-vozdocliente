    {
      "parameters": {
        "jsCode": "// Faz o parse do JSON que o LLM devolveu e junta com o payload original do webhook.\n// Agora trata respostas inválidas do LLM e valida sentiment/theme.\n\nconst llmRaw = $json?.choices?.[0]?.message?.content;\n\nif (!llmRaw || typeof llmRaw !== 'string') {\n  throw new Error('Resposta do LLM ausente ou em formato inválido.');\n}\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(llmRaw);\n} catch (error) {\n  throw new Error(`Resposta do LLM não é um JSON válido: ${llmRaw}`);\n}\n\nconst webhook = $('Webhook Review').first().json.body;\n\nconst sentiment = (parsed.sentiment || '').toLowerCase().trim();\nconst theme = (parsed.theme || '').toLowerCase().trim();\n\nconst allowedSentiments = ['positivo', 'neutro', 'negativo'];\nconst allowedThemes = ['entrega', 'produto', 'atendimento', 'preco', 'app_bug'];\n\nif (!allowedSentiments.includes(sentiment)) {\n  throw new Error(`Sentiment inválido: ${sentiment}`);\n}\n\nif (!allowedThemes.includes(theme)) {\n  throw new Error(`Theme inválido: ${theme}`);\n}\n\nreturn [\n  {\n    json: {\n      review_id: webhook.review_id,\n      customer_name: webhook.customer_name,\n      source: webhook.source,\n      rating: webhook.rating,\n      review_text: webhook.review_text,\n      sentiment: sentiment,\n      theme: theme,\n      processed_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "f5c574cf-8213-4044-8336-dac5c956dd88",
      "name": "Parse + Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
