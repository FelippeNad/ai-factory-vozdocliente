# ---------------------------------------------------------------------------
# VozDoCliente — Environment Variables
# ---------------------------------------------------------------------------
# Este arquivo documenta as variáveis utilizadas pelos ambientes do projeto.
#
# NUNCA coloque valores reais de secrets neste arquivo.
# Copie para .env apenas no ambiente local quando necessário.
# Arquivos .env são ignorados pelo Git.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Airtable
# ---------------------------------------------------------------------------
# Identificador da base usada pelo workflow.
# DEV e PROD devem utilizar valores diferentes.
#
# Exemplo:
# AIRTABLE_BASE_ID=SEU_ID_DA_BASE_DEV

AIRTABLE_BASE_ID=


# ---------------------------------------------------------------------------
# Credenciais de integrações
# ---------------------------------------------------------------------------
# As credenciais abaixo são configuradas como Credentials no n8n
# ou como secrets na infraestrutura de produção.
#
# Não devem ser commitadas no repositório.

OPENAI_API_KEY=
AIRTABLE_PAT=
SLACK_BOT_TOKEN=


# ---------------------------------------------------------------------------
# n8n — produção
# ---------------------------------------------------------------------------
# Chave utilizada pelo n8n para criptografar credenciais.
# Deve permanecer fixa entre reinicializações do ambiente.
#
# Nunca versionar o valor real.

N8N_ENCRYPTION_KEY=

# Diretório persistente utilizado pelo n8n no Railway.

N8N_USER_FOLDER=/home/node

# URL pública utilizada pelos webhooks em produção.
#
# Exemplo:
# N8N_WEBHOOK_URL=https://seu-servico.up.railway.app

N8N_WEBHOOK_URL=

# Permite acesso a variáveis de ambiente dentro das expressões do workflow.

N8N_BLOCK_ENV_ACCESS_IN_NODE=false


# ---------------------------------------------------------------------------
# Configuração geral
# ---------------------------------------------------------------------------

GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Etapa 2 - retencao (apenas DEV; workflow independente e inativo)
# ---------------------------------------------------------------------------
# 30 dias e demonstrativo, nao prazo legal. Configuracao ausente/invalida bloqueia.
# A DEMO OFFLINE nao precisa dessas variaveis nem de credenciais.
# O Compose independente docker-compose.retention.yml repassa estas variaveis.
RETENTION_ENV=
RETENTION_DRY_RUN=true
RETENTION_DAYS=30
RETENTION_DEV_BASE_ID=
RETENTION_TABLE_ID=
# Nome exato da tabela selecionada pelo ID; para testes: ReviewsRetentionTest.
# Ausente usa Reviews; vazio/espacos nas extremidades bloqueiam (fail-closed).
RETENTION_TABLE_NAME=Reviews
RETENTION_AUDIT_TABLE_ID=
RETENTION_PAGE_SIZE=100
RETENTION_MAX_PAGES=10
RETENTION_MAX_ANALYZED=1000
RETENTION_MAX_DELETE=10

# Observabilidade DEV: alerta opt-in, credencial Slack DEV configurada so no n8n.
# Nunca reutilizar token/canal PROD. Logs e metricas usam somente campos permitidos.
RETENTION_ALERTS_ENABLED=false
RETENTION_SLACK_DEV_CHANNEL_ID=
# O Compose DEV habilita CODE_ENABLE_STDOUT=true e rotacao Docker por tamanho.
# Execucoes manuais enviam console.log ao browser, nao ao stdout do servidor.

# Bases que jamais podem ser acessadas pela limpeza (IDs separados por virgula).
# Preencher fora do repositorio; nao colocar identificadores reais neste exemplo.
RETENTION_PROTECTED_BASE_IDS=
# Alem de DRY_RUN=false, exclusao exige ENV=DEV, denylist nao vazia,
# confirmacao exata do ID DEV e a frase DELETE_DEV_EXPIRED_REVIEWS.
# Manter vazios durante a demonstracao/DRY_RUN. Nenhuma exclusao foi autorizada.
RETENTION_CONFIRM_DEV_BASE_ID=
RETENTION_DELETE_CONFIRMATION=

# Historico interno n8n e DIFERENTE das reviews no Airtable.
# Proposta aplicada apenas ao usar o Compose DEV de retencao (nao configura producao):
# EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
# EXECUTIONS_DATA_SAVE_ON_ERROR=none
# EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
# EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
# EXECUTIONS_DATA_PRUNE=true
# EXECUTIONS_DATA_MAX_AGE=168              # horas = 7 dias, demonstrativo
# EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
# EXECUTIONS_DATA_HARD_DELETE_BUFFER=1    # horas, nao exclusao imediata
# EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL=60
# EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=15

# Candidato de classificacao v4 otimizado, apenas DEV. Nao usa AIRTABLE_BASE_ID.
# Repassar explicitamente ao ambiente n8n DEV se futuramente importar o candidato.
# O benchmark offline usa configuracao sintetica e nao le este arquivo.
CLASSIFIER_ENV=
CLASSIFIER_DEV_BASE_ID=
CLASSIFIER_DEV_TABLE_ID=
CLASSIFIER_SLACK_DEV_CHANNEL_ID=
# Observador por subworkflow e Error Workflow: IDs locais, definidos apos importar.
ROUTER_OBSERVER_WORKFLOW_ID=
ROUTER_OBSERVED_WORKFLOW_ID=
ROUTER_ALERTS_ENABLED=false
# Opt-in global para console.log nao manual; revisar outros workflows antes.
ROUTER_OBS_STDOUT_ENABLED=false
# Precos por milhao de tokens em USD, confirmados manualmente para o modelo/projeto.
# Vazios => custo desconhecido. Nao sao precos oficiais nem custo faturado.
OBS_LLM_INPUT_USD_PER_MILLION=
OBS_LLM_OUTPUT_USD_PER_MILLION=
# N8N_LOG_LEVEL=warn
# N8N_CONCURRENCY_PRODUCTION_LIMIT=1     # nao serializa execucoes manuais
