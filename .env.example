# ---------------------------------------------------------------------------
# VozDoCliente — Environment Variables
# ---------------------------------------------------------------------------
# Este arquivo documenta as variáveis utilizadas pelos ambientes do projeto.
#
# NUNCA coloque valores reais de secrets neste arquivo.
# Copie para .env apenas no ambiente local quando necessário.
# Arquivos .env são ignorados pelo Git.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Airtable
# ---------------------------------------------------------------------------
# Identificador da base usada pelo workflow.
# DEV e PROD devem utilizar valores diferentes.
#
# Exemplo:
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

AIRTABLE_BASE_ID=


# ---------------------------------------------------------------------------
# Credenciais de integrações
# ---------------------------------------------------------------------------
# As credenciais abaixo são configuradas como Credentials no n8n
# ou como secrets na infraestrutura de produção.
#
# Não devem ser commitadas no repositório.

OPENAI_API_KEY=
AIRTABLE_PAT=
SLACK_BOT_TOKEN=


# ---------------------------------------------------------------------------
# n8n — produção
# ---------------------------------------------------------------------------
# Chave utilizada pelo n8n para criptografar credenciais.
# Deve permanecer fixa entre reinicializações do ambiente.
#
# Nunca versionar o valor real.

N8N_ENCRYPTION_KEY=

# Diretório persistente utilizado pelo n8n no Railway.

N8N_USER_FOLDER=/home/node

# URL pública utilizada pelos webhooks em produção.
#
# Exemplo:
# N8N_WEBHOOK_URL=https://seu-servico.up.railway.app

N8N_WEBHOOK_URL=

# Permite acesso a variáveis de ambiente dentro das expressões do workflow.

N8N_BLOCK_ENV_ACCESS_IN_NODE=false


# ---------------------------------------------------------------------------
# Configuração geral
# ---------------------------------------------------------------------------

GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo