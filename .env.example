# ---------------------------------------------------------------------------
# VozDoCliente Review Router — .env.example
# ---------------------------------------------------------------------------
# Stack C (Make.com): a MAIORIA das credenciais vive como "Connections" dentro
# do Make (OpenAI, Airtable, Slack) e NÃO sai no blueprint exportado.
# No espelho n8n, as credenciais são criadas pela UI (Credentials Header Auth).
# Este .env serve pro docker-compose do n8n e pra um futuro CI que versione
# o blueprint do Make via API.
# ---------------------------------------------------------------------------

# --- n8n mirror (docker-compose) ---
# Base do Airtable usada pelo node "Airtable Create" via {{$env.AIRTABLE_BASE_ID}}
AIRTABLE_BASE_ID=

# --- Credenciais (NÃO comitar valores reais) ---
# Usadas ao recriar as credentials Header Auth na UI do n8n / Connections no Make.
# OpenAI: hoje é a chave PESSOAL da Sther — ROTACIONAR pra conta corporativa.
OPENAI_API_KEY=
AIRTABLE_PAT=
SLACK_BOT_TOKEN=

# --- Make.com API (futuro CI/CD que versiona o blueprint) ---
MAKE_API_KEY=
MAKE_TEAM_ID=
MAKE_SCENARIO_ID=

# Timezone
TZ=America/Sao_Paulo
